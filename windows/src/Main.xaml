<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今日 · TodayNote" Width="400" Height="640" MinWidth="340" MinHeight="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        Foreground="{DynamicResource Tone_303236}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Tone_303236" Color="#303236"/>
    <SolidColorBrush x:Key="Tone_55585E" Color="#55585E"/>
    <SolidColorBrush x:Key="Tone_707278" Color="#707278"/>
    <SolidColorBrush x:Key="Tone_858D87" Color="#858D87"/>
    <SolidColorBrush x:Key="Tone_92959B" Color="#92959B"/>
    <SolidColorBrush x:Key="Tone_9B9EA4" Color="#9B9EA4"/>
    <SolidColorBrush x:Key="Tone_A5A8AD" Color="#A5A8AD"/>
    <SolidColorBrush x:Key="Tone_A8ABB0" Color="#A8ABB0"/>
    <SolidColorBrush x:Key="Tone_C6C9CE" Color="#C6C9CE"/>
    <SolidColorBrush x:Key="Tone_CCD3DC" Color="#CCD3DC"/>
    <SolidColorBrush x:Key="Tone_DDDFE2" Color="#DDDFE2"/>
    <SolidColorBrush x:Key="Tone_DFE1E4" Color="#DFE1E4"/>
    <SolidColorBrush x:Key="Tone_E2E3E5" Color="#E2E3E5"/>
    <SolidColorBrush x:Key="Tone_E2E4E7" Color="#E2E4E7"/>
    <SolidColorBrush x:Key="Tone_E8EAED" Color="#E8EAED"/>
    <SolidColorBrush x:Key="Tone_EAEBED" Color="#EAEBED"/>
    <SolidColorBrush x:Key="Tone_ECEDEF" Color="#ECEDEF"/>
    <SolidColorBrush x:Key="Tone_EFF0F2" Color="#EFF0F2"/>
    <SolidColorBrush x:Key="Tone_F4F5F6" Color="#F4F5F6"/>
    <SolidColorBrush x:Key="Tone_FDFDFD" Color="#FDFDFD"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Tone_707278}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Tone_ECEDEF}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Tone_DFE1E4}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="2,4"/>
      <Setter Property="Foreground" Value="{DynamicResource Tone_303236}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Tone_CCD3DC}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Tone_55585E}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="29"/>
      <Setter Property="Foreground" Value="{DynamicResource Tone_303236}"/>
      <Setter Property="Background" Value="{DynamicResource Tone_F3F4F6}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Tone_E2E3E5}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="ComboSurface" CornerRadius="7" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Tone_707278}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
              </Border>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="Background" Value="{DynamicResource Tone_ECEDEF}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="10,5,28,5" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource Tone_FDFDFD}" BorderBrush="{DynamicResource Tone_E2E3E5}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,3,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Tone_303236}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ComboItemSurface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ComboItemSurface" Property="Background" Value="{DynamicResource Tone_ECEDEF}"/></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ComboItemSurface" Property="Background" Value="{DynamicResource Tone_DFE1E4}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Tone_303236}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border x:Name="CheckSurface" Width="16" Height="16" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Tone_C7CBD0}" Background="{DynamicResource Tone_F3F4F6}" VerticalAlignment="Center">
            <Path x:Name="CheckMark" Data="M 3 7 L 6 10 L 12 4" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource Tone_858D87}"/><Setter TargetName="CheckSurface" Property="BorderThickness" Value="0"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Foreground" Value="{DynamicResource Tone_303236}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="{DynamicResource Tone_FDFDFD}" BorderBrush="{DynamicResource Tone_E2E3E5}" BorderThickness="1" CornerRadius="8" Padding="4"><StackPanel IsItemsHost="True"/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Tone_303236}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="MenuSurface" Background="Transparent" CornerRadius="5" Padding="8,7" MinWidth="106">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MenuCheck" Text="✓" Visibility="Hidden"/>
            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource Tone_ECEDEF}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="MenuCheck" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Tone_C6C9CE}" CornerRadius="3" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Tone_303236}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{DynamicResource Tone_FDFDFD}" BorderBrush="{DynamicResource Tone_E2E3E5}" BorderThickness="1" CornerRadius="6" Padding="9,6"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Margin="12" CornerRadius="19" Background="{DynamicResource Tone_FDFDFD}" BorderBrush="{DynamicResource Tone_E2E3E5}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="19" ShadowDepth="4" Color="#000000" Opacity="0.12"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="68"/>
        <RowDefinition Height="41"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="35"/>
      </Grid.RowDefinitions>
      <Grid x:Name="DragHeader" Background="Transparent" Margin="22,10,14,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource Tone_E2E4E7}" Width="7" Height="7" CornerRadius="4" Margin="0,1,10,0"/>
          <TextBlock Text="今日" FontSize="22" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PinButton" Content="&#xE718;" Style="{StaticResource IconButton}" ToolTip="置顶"/>
          <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource IconButton}" ToolTip="设置"/>
          <Button x:Name="HideButton" Content="&#xE921;" Style="{StaticResource IconButton}" ToolTip="收起到托盘"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="23,0,23,7">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="3"/></Grid.RowDefinitions>
        <TextBlock x:Name="DateLabel" FontSize="12" Foreground="{DynamicResource Tone_92959B}" VerticalAlignment="Top"/>
        <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource Tone_92959B}" VerticalAlignment="Top"/>
        <Border Grid.Row="1" CornerRadius="2" Background="{DynamicResource Tone_EFF0F2}"/>
        <Grid Grid.Row="1" x:Name="ProgressTrack"><Border x:Name="ProgressFill" CornerRadius="2" Background="{DynamicResource Tone_858D87}" HorizontalAlignment="Left" Width="0"/></Grid>
      </Grid>
      <Grid Grid.Row="2" Margin="13,8,10,3">
        <ScrollViewer x:Name="TaskScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="3,0,7,0" CanContentScroll="False">
          <StackPanel x:Name="TaskList"/>
        </ScrollViewer>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20" IsHitTestVisible="False">
          <TextBlock Text="○" FontSize="35" Foreground="{DynamicResource Tone_DDDFE2}" HorizontalAlignment="Center"/>
          <TextBlock Text="给今天留一点小目标" FontSize="13" Foreground="{DynamicResource Tone_A8ABB0}" Margin="0,12,0,0"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="3" Margin="20,10,20,0" Padding="12,9,10,10" Background="{DynamicResource Tone_F4F5F6}" CornerRadius="12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="NewTitle" MaxLength="500" FontSize="14" MinHeight="30" VerticalContentAlignment="Center" ToolTip="输入内容，按 Enter 添加"/>
              <TextBlock x:Name="Placeholder" Text="添加待办…" Foreground="{DynamicResource Tone_9B9EA4}" Margin="2,6,0,0" IsHitTestVisible="False"/>
            </Grid>
            <Button Grid.Column="1" x:Name="AddButton" Content="&#xE710;" Style="{StaticResource IconButton}" ToolTip="添加 · Enter" Background="{DynamicResource Tone_E8EAED}"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="UrgencyButton" Padding="8,4" FontSize="11" Background="{DynamicResource Tone_EAEBED}" Margin="0,0,7,0" ToolTip="选择紧急程度"/>
            <Button x:Name="ImportanceButton" Padding="8,4" FontSize="11" Background="{DynamicResource Tone_EAEBED}" ToolTip="选择重要程度"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Row="4" Margin="20,0,15,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="StatusLabel" FontSize="10" Foreground="{DynamicResource Tone_A5A8AD}" VerticalAlignment="Center"/>
          <Button x:Name="UndoButton" Content="撤销" Visibility="Collapsed" FontSize="10" Padding="6,2" Margin="6,0,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="HistoryButton" Content="&#xE81C;" FontSize="12" Style="{StaticResource IconButton}" Height="25" Width="25" ToolTip="完成记录"/>
      </Grid>
      <Thumb x:Name="ResizeGrip" Grid.Row="4" Width="14" Height="14" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="SizeNWSE" Margin="0,0,3,3" ToolTip="拖动调整大小">
        <Thumb.Template><ControlTemplate><Grid Background="Transparent"><Path Data="M 4 10 L 10 4 M 8 10 L 10 8" Stroke="{DynamicResource Tone_C6C9CE}" StrokeThickness="1"/></Grid></ControlTemplate></Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</Window>
